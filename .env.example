# Copy this file to `.env` and fill in real values (never commit `.env`).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=theme1_dev

# Generate with:  mix phx.gen.secret   (run inside theme1/)
SECRET_KEY_BASE=replace_me_with_a_64_char_secret

# Public hostname used by Phoenix for URL generation (no http://)
PHX_HOST=localhost